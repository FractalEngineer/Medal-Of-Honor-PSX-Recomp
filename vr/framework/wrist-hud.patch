+static inline void xr_surface_rotate(const float q[4],const float p[3],float out[3]) {
+    float t[3]={2*(q[1]*p[2]-q[2]*p[1]),2*(q[2]*p[0]-q[0]*p[2]),2*(q[0]*p[1]-q[1]*p[0])};
